include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include README.md
include SECURITY.md
include pyproject.toml
recursive-include benchmarks *.json *.py
recursive-include docs *.md
recursive-include evals *.json *.jsonl *.md *.py
